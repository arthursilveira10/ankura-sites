---
// Página de procedimento: uma por arquivo em src/content/paginas/ com tipo: procedimento.
import Pagina from '../components/Pagina.astro';
import { procedimentos } from '../lib/dados';

export async function getStaticPaths() {
  const lista = await procedimentos();
  return lista.map((p) => ({ params: { slug: p.id }, props: { pagina: p } }));
}
const { pagina } = Astro.props;
---

<Pagina pagina={pagina} />
