---
// Ícones de interface (traço 1.6, 24×24). Ícones do conceito do cliente ficam em src/components/conceito/.
interface Props {
  nome: 'whatsapp' | 'seta' | 'seta-baixo' | 'mais' | 'instagram' | 'local' | 'relogio' | 'menu' | 'fechar' | 'estrela';
  class?: string;
  tamanho?: number;
}
const { nome, class: classe, tamanho = 20 } = Astro.props;
---

<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nome === 'whatsapp' && (
      <>
        <path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6z" />
        <path d="M9.2 8.6c.2-.5.6-.5.9-.5h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.4.7 1.3 1.6 2.1 2 .2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.2.3.4 0 .5-.2 1.4-1.2 1.7-.9.3-2.4 0-4-1.3-1.7-1.4-2.6-3.1-2.7-4 0-.6.1-1.2.2-1.6z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {nome === 'seta' && <path d="M6 18L18 6M9 6h9v9" />}
  {nome === 'seta-baixo' && <path d="M6 9l6 6 6-6" />}
  {nome === 'mais' && <path d="M12 5v14M5 12h14" />}
  {
    nome === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    nome === 'local' && (
      <>
        <path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11z" />
        <circle cx="12" cy="10" r="2.4" />
      </>
    )
  }
  {
    nome === 'relogio' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {nome === 'menu' && <path d="M4 8h16M4 16h16" />}
  {nome === 'fechar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nome === 'estrela' && <path d="M12 3.8l2.5 5.1 5.6.8-4 4 .9 5.6L12 16.7l-5 2.6.9-5.6-4-4 5.6-.8z" fill="currentColor" stroke="none" />}
</svg>
