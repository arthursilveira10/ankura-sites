---
// Ícones de interface e de informação (traço 1.6, 24×24). Ícones do conceito do cliente ficam em src/components/conceito/.
// Os nomes também são usados no conteúdo (campo "icone"): lista em src/lib/icones.ts.
import type { IconeNome } from '../../lib/icones';
interface Props {
  nome: IconeNome;
  class?: string;
  tamanho?: number;
}
const { nome, class: classe, tamanho = 20 } = Astro.props;
---

<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nome === 'whatsapp' && (
      <>
        <path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6z" />
        <path d="M9.2 8.6c.2-.5.6-.5.9-.5h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.4.7 1.3 1.6 2.1 2 .2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.2.3.4 0 .5-.2 1.4-1.2 1.7-.9.3-2.4 0-4-1.3-1.7-1.4-2.6-3.1-2.7-4 0-.6.1-1.2.2-1.6z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {nome === 'seta' && <path d="M6 18L18 6M9 6h9v9" />}
  {nome === 'seta-baixo' && <path d="M6 9l6 6 6-6" />}
  {nome === 'mais' && <path d="M12 5v14M5 12h14" />}
  {
    nome === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    nome === 'local' && (
      <>
        <path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11z" />
        <circle cx="12" cy="10" r="2.4" />
      </>
    )
  }
  {
    nome === 'relogio' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {nome === 'menu' && <path d="M4 8h16M4 16h16" />}
  {nome === 'fechar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nome === 'estrela' && <path d="M12 3.8l2.5 5.1 5.6.8-4 4 .9 5.6L12 16.7l-5 2.6.9-5.6-4-4 5.6-.8z" fill="currentColor" stroke="none" />}
  {nome === 'cracha' && (<><rect x="3" y="5" width="18" height="14" rx="2.5" /><circle cx="9" cy="11" r="2.2" /><path d="M6 16.2c.7-1.5 1.8-2.2 3-2.2s2.3.7 3 2.2M14.5 10h4M14.5 13h3" /></>)}
  {nome === 'selo' && (<><circle cx="12" cy="9" r="5.5" /><path d="m9.2 13.8-1.2 7.2 4-2 4 2-1.2-7.2M10 9l1.4 1.4L14.2 7.6" /></>)}
  {nome === 'porta' && (<><path d="M4 21h16M7 21V3.5h10V21" /><path d="M14.2 12.2v.1" /></>)}
  {nome === 'online' && (<><rect x="3" y="5" width="18" height="12" rx="2" /><path d="M8 21h8M12 17v4" /></>)}
  {nome === 'chapeu' && (<><path d="m2.5 9 9.5-4.5L21.5 9 12 13.5 2.5 9Z" /><path d="M6.5 11v4.5c1.5 1.4 3.4 2 5.5 2s4-.6 5.5-2V11M21.5 9v5" /></>)}
  {nome === 'calendario' && (<><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></>)}
  {nome === 'frasco' && (<><path d="M10 3h4v3.2l2.2 2.3V20a1 1 0 0 1-1 1H8.8a1 1 0 0 1-1-1V8.5L10 6.2V3Z" /><path d="M7.8 12.5h8.4" /></>)}
  {nome === 'sol' && (<><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.5 1.5M17.2 17.2l1.5 1.5M5.3 18.7l1.5-1.5M17.2 6.8l1.5-1.5" /></>)}
  {nome === 'rosto' && (<><path d="M12 3c3.9 0 6.5 3 6.5 7.3S15.8 21 12 21s-6.5-6.4-6.5-10.7S8.1 3 12 3Z" /><path d="M8.8 7.6c1 .4 2.1.4 3.2 0M12 7.6c1.1.4 2.2.4 3.2 0M9.5 15.2c1.6 1 3.4 1 5 0" /></>)}
  {nome === 'conversa' && <path d="M4 5.5h16v10H9l-5 4v-14Z" />}
  {nome === 'lupa' && (<><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></>)}
  {nome === 'coracao' && <path d="M12 20s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7.6 4.2 4.2 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10Z" />}
</svg>
