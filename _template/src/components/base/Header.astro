---
// Menu. Desktop: pílula flutuante sempre visível, com o botão de agendar.
// Celular: barra de borda a borda com o logo centralizado e o botão de menu; transparente no topo,
// some ao rolar para baixo e volta ao rolar para cima (fx.ts). Modo LP: sem links.
import Botao from './Botao.astro';
import Marca from '../conceito/Marca.astro';

interface Props {
  links: { texto: string; href: string }[];
  botao: string;
}
const { links, botao } = Astro.props;
const modoLP = Astro.locals.ctx?.modoLP;
---

<header class="hd" data-header data-rolado="nao" data-oculto="nao">
  <div class="hd-barra">
    <span class="hd-lado" aria-hidden="true"></span>
    <a href={modoLP ? '#conteudo' : '/'} class="hd-marca">
      <Marca />
    </a>

    {
      !modoLP && (
        <nav class="hd-nav" aria-label="Principal">
          {links.map((l) => (
            <a href={l.href} class="hd-link">
              {l.texto}
            </a>
          ))}
        </nav>
      )
    }

    <div class="hd-acoes">
      <Botao texto={botao} posicao="menu" compacto class="hd-botao" />
      {
        !modoLP && (
          <button class="hd-menu" type="button" aria-expanded="false" aria-controls="painel-menu" data-botao-menu>
            <span class="sr-only">Menu</span>
            <span class="tracos" aria-hidden="true"><span></span><span></span></span>
          </button>
        )
      }
    </div>
  </div>

  {
    !modoLP && (
      <div class="painel" id="painel-menu" data-painel-menu>
        <nav aria-label="Menu do celular">
          {links.map((l) => (
            <a href={l.href} class="painel-link">
              {l.texto}
            </a>
          ))}
        </nav>
        <Botao texto={botao} posicao="menu" />
      </div>
    )
  }
</header>

<style>
  .hd {
    position: fixed;
    inset: var(--aviso, 0px) 0 auto;
    z-index: 50;
    transition: transform 0.6s var(--ease-ankura);
  }
  .hd[data-oculto='sim'] {
    transform: translateY(-120%);
  }

  /* celular: barra de borda a borda, logo no centro */
  .hd-barra {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 12px;
    padding: 10px var(--margem);
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .hd[data-rolado='sim'] .hd-barra,
  :global(html[data-menu='aberto']) .hd-barra {
    background: color-mix(in oklab, var(--color-fundo) 90%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--color-linha);
  }
  .hd-marca {
    justify-self: center;
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-tinta);
    text-decoration: none;
    text-align: center;
  }
  .hd-nav {
    display: none;
  }
  .hd-acoes {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }
  .hd-acoes :global(.hd-botao) {
    display: none;
  }
  .hd-menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-tinta) 22%, transparent);
    cursor: pointer;
  }
  .tracos {
    display: grid;
    gap: 5px;
    justify-items: end;
  }
  .tracos span {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--color-tinta);
    transition: transform 0.4s var(--ease-ankura), width 0.4s var(--ease-ankura);
  }
  .tracos span + span {
    width: 10px;
  }
  :global(html[data-menu='aberto']) .tracos span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  :global(html[data-menu='aberto']) .tracos span + span {
    width: 16px;
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .painel {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding: 110px var(--margem) 40px;
    background: var(--color-fundo);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0.4s;
  }
  :global(html[data-menu='aberto']) .painel {
    opacity: 1;
    visibility: visible;
  }
  :global(html[data-menu='aberto']) {
    overflow: hidden;
  }
  .painel nav {
    display: grid;
    gap: 6px;
    text-align: center;
  }
  .painel :global(.botao) {
    align-self: center;
  }
  .painel-link {
    font-family: var(--font-titulo);
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    line-height: 1.2;
    color: var(--color-tinta);
    text-decoration: none;
    padding-block: 4px;
  }

  /* desktop: no topo, o menu flutua quase sem fundo e na largura do conteúdo, para o topo ter destaque total;
     ao rolar, o fundo de vidro aparece e a pílula condensa para uma largura mais enxuta */
  @media (min-width: 1024px) {
    .hd {
      padding: 16px var(--margem) 0;
    }
    .hd[data-oculto='sim'] {
      transform: none;
    }
    .hd-barra,
    .hd[data-rolado='sim'] .hd-barra {
      max-width: var(--largura);
      margin-inline: auto;
      display: flex;
      gap: 20px;
      padding: 8px 8px 8px 28px;
      border-radius: var(--radius-pilula);
      background: color-mix(in oklab, var(--color-superficie) 14%, transparent);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      box-shadow: inset 0 0 0 1px rgb(20 38 32 / 0.05);
      transition:
        max-width 0.8s var(--ease-ankura),
        padding 0.8s var(--ease-ankura),
        background-color 0.6s ease,
        box-shadow 0.6s ease,
        backdrop-filter 0.6s ease;
    }
    .hd[data-rolado='sim'] .hd-barra {
      max-width: 1040px;
      padding: 7px 7px 7px 24px;
      background: color-mix(in oklab, var(--color-superficie) 88%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow:
        inset 0 0 0 1px var(--color-linha),
        0 16px 40px -24px rgb(20 38 32 / 0.35);
    }
    .hd-lado {
      display: none;
    }
    .hd-marca {
      justify-self: auto;
      margin-right: auto;
      text-align: left;
    }
    .hd-nav {
      display: flex;
      gap: 2px;
    }
    .hd-link {
      padding: 9px 16px;
      border-radius: var(--radius-pilula);
      font-size: 0.9375rem;
      color: var(--color-tinta);
      text-decoration: none;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
    }
    .hd-link:hover {
      background: var(--color-tinta);
      color: var(--color-fundo);
    }
    .hd-acoes :global(.hd-botao) {
      display: inline-flex;
    }
    .hd-menu,
    .painel {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hd,
    .hd-barra,
    .painel,
    .tracos span {
      transition: none;
    }
  }
</style>
