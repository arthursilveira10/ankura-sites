---
// Cabeçalho padrão de seção: rótulo (opcional, evite) + título + texto de apoio.
// No celular, todos os cabeçalhos ficam centralizados (regra única da página).
// lado: no desktop, título à esquerda e texto à direita, alinhados pela base.
import { titulo as fmtTitulo, paragrafos } from '../../lib/texto';
interface Props {
  rotulo?: string;
  titulo: string;
  texto?: string;
  centro?: boolean;
  id?: string;
  nivel?: 'h1' | 'h2';
  classe?: string;
  lado?: boolean;
}
const { rotulo, titulo, texto, centro = false, id, nivel = 'h2', classe = 't-h2', lado = false } = Astro.props;
const H = nivel;
---

<div class:list={['cab', centro && 'cab-centro', lado && 'cab-lado']}>
  {rotulo && <p class="rotulo">{rotulo}</p>}
  <H id={id} class:list={[classe, 'medida-titulo']} set:html={fmtTitulo(titulo)} />
  {
    texto && (
      <div class="cab-texto medida texto">
        {paragrafos(texto).map((p) => (
          <p set:html={p} />
        ))}
      </div>
    )
  }
</div>

<style>
  .cab {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .cab-centro {
    justify-items: center;
    text-align: center;
  }
  .cab-centro .medida-titulo,
  .cab-centro .medida {
    margin-inline: auto;
  }
  .cab-texto {
    color: inherit;
  }
  @media (max-width: 1023px) {
    .cab {
      justify-items: center;
      text-align: center;
    }
    .cab .medida-titulo,
    .cab .medida {
      margin-inline: auto;
      max-width: 24em;
    }
  }
  @media (min-width: 1024px) {
    .cab-lado {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 48px;
    }
    .cab-lado .cab-texto {
      justify-self: end;
      max-width: 26em;
    }
  }
</style>
