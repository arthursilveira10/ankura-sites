---
// Dados de identificação (CRM, RQE, cidade, modalidade) com ícones, numa barra clara.
// Usado dentro do topo (encaixado na base da foto) e pela seção faixa-dados.
import Icone from './Icone.astro';
import { medico } from '../../lib/dados';
import type { IconeNome } from '../../lib/icones';

interface Props {
  itens?: { rotulo: string; valor: string; icone?: IconeNome }[];
  class?: string;
}
const { itens: proprios, class: classe } = Astro.props;
const m = await medico();
const itens = proprios ?? [
  { rotulo: 'CRM', valor: m.crm, icone: 'cracha' as IconeNome },
  ...(m.rqe ? [{ rotulo: `Especialista em ${m.especialidade.toLowerCase()}`, valor: `RQE ${m.rqe}`, icone: 'selo' as IconeNome }] : []),
  { rotulo: 'Consultório', valor: `${m.cidade}, ${m.uf}`, icone: 'local' as IconeNome },
  { rotulo: 'Atendimento', valor: m.modalidade, icone: (/online/i.test(m.modalidade) ? 'online' : 'porta') as IconeNome },
];
---

<ul class:list={['dados', classe]} aria-label="Identificação profissional">
  {
    itens.map((i) => (
      <li class="dados-item">
        {i.icone && <Icone nome={i.icone} tamanho={26} class="dados-ico" />}
        <span>
          <span class="dt">{i.rotulo}</span>
          <span class="dd">{i.valor}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .dados {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 22px;
    background: color-mix(in oklab, var(--color-superficie) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 0 0 1px var(--color-linha),
      0 24px 50px -34px rgb(20 38 32 / 0.5);
  }
  .dados-item {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 14px 12px;
  }
  .dados-item:nth-child(even) {
    border-left: 1px solid var(--color-linha);
  }
  .dados-item:nth-child(n + 3) {
    border-top: 1px solid var(--color-linha);
  }
  .dados :global(.dados-ico) {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--color-acao);
  }
  .dt {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-apagado);
  }
  .dd {
    display: block;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-tinta);
  }
  @media (min-width: 1024px) {
    .dados {
      grid-template-columns: repeat(4, 1fr);
      padding: 18px 8px;
    }
    .dados-item {
      gap: 14px;
      padding: 6px 22px;
    }
    .dados-item:nth-child(n) {
      border-left: 1px solid var(--color-linha);
      border-top: 0;
    }
    .dados-item:first-child {
      border-left: 0;
    }
    .dados :global(.dados-ico) {
      width: 26px;
      height: 26px;
    }
    .dd {
      font-size: 1rem;
    }
  }
</style>
