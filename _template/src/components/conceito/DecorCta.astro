---
// FUNDO DO CTA FINAL (por cliente). Demo "Luz de janela": o pôr do sol, em arcos de verde com um fio de luz.
// Faz par com o sol que nasce atrás do médico no topo.
---

<svg class="poente decor" viewBox="0 0 1500 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <radialGradient id="poente-brilho" cx="50%" cy="100%" r="50%">
      <stop offset="0" stop-color="#F2D49B" stop-opacity=".5"></stop>
      <stop offset=".55" stop-color="#F2D49B" stop-opacity=".07"></stop>
      <stop offset="1" stop-color="#F2D49B" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <circle cx="750" cy="520" r="520" fill="#18322B"></circle>
  <circle cx="750" cy="520" r="420" fill="#1D3A32"></circle>
  <circle cx="750" cy="520" r="330" fill="#24443A"></circle>
  <circle cx="750" cy="520" r="250" fill="#2C5045"></circle>
  <rect width="1500" height="260" fill="url(#poente-brilho)"></rect>
  <circle cx="750" cy="520" r="250" fill="none" stroke="#F2D49B" stroke-opacity=".55" stroke-width="1.5"></circle>
</svg>

<style>
  .poente {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1500px;
    height: 260px;
    transform: translateX(-50%);
    z-index: 0;
  }
</style>
