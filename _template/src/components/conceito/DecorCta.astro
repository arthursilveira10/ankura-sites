---
// DECORAÇÃO DO CTA FINAL (por cliente). Demo: curvas de nível claras no fundo escuro.
import { curvasFechadas } from './topografia';
const curvas = curvasFechadas({ cx: 400, cy: 400, raio: 390, niveis: 12, semente: 29, irregular: 0.2 });
---

<svg class="decor decor-cta" viewBox="0 0 800 800" aria-hidden="true">
  {curvas.map((d) => <path d={d} />)}
</svg>

<style>
  .decor-cta {
    position: absolute;
    z-index: 0;
    left: 70%;
    top: 55%;
    width: max(110%, 900px);
    transform: translate(-50%, -50%);
    fill: none;
    stroke: var(--color-escuro-texto);
    stroke-width: 1;
    opacity: 0.12;
  }
  .decor-cta path {
    vector-effect: non-scaling-stroke;
  }
</style>
