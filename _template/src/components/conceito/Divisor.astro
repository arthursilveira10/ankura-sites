---
// DIVISOR DO CONCEITO (por cliente). Demo "Luz de janela": a linha do horizonte.
// - borda="faixa": topo arqueado de uma faixa de fundo, com um fio de luz dourado (transição entre fundos).
// - sozinho (tipo "divisor" no conteúdo): um arco fino de horizonte entre duas seções no mesmo fundo.
interface Props {
  borda?: 'faixa';
  semente?: number; // mantido por compatibilidade com o conteúdo antigo
}
const { borda } = Astro.props;
const id = `luz-${Math.random().toString(36).slice(2, 8)}`;
---

{
  borda === 'faixa' ? (
    <svg class="horizonte decor" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={id} x1="0" x2="1">
          <stop offset="0" stop-color="#F2D49B" stop-opacity="0" />
          <stop offset=".5" stop-color="#E9B95E" stop-opacity=".9" />
          <stop offset="1" stop-color="#F2D49B" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path fill="var(--color-superficie-2)" d="M0 90C340 10 1100 10 1440 90Z" />
      <path fill="none" stroke={`url(#${id})`} stroke-width="2" d="M0 90C340 10 1100 10 1440 90" />
    </svg>
  ) : (
    <div class="wrap divisor" aria-hidden="true">
      <svg class="decor" viewBox="0 0 1240 40" preserveAspectRatio="none">
        <defs>
          <linearGradient id={id} x1="0" x2="1">
            <stop offset="0" stop-color="#E9B95E" stop-opacity="0" />
            <stop offset=".5" stop-color="#E9B95E" stop-opacity=".8" />
            <stop offset="1" stop-color="#E9B95E" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path fill="none" stroke={`url(#${id})`} stroke-width="1.5" d="M0 38C300 4 940 4 1240 38" />
      </svg>
    </div>
  )
}

<style>
  .horizonte {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% - 1px);
    width: 100%;
    height: clamp(48px, 6vw, 90px);
    display: block;
  }
  .divisor svg {
    display: block;
    width: 100%;
    height: 40px;
  }
</style>
