---
// ÍCONES DOS PROCEDIMENTOS (por cliente): traço único, pathLength="1" para se desenharem ao aparecer.
// Demo "Leitura da pele": 0 = linhas de expressão (toxina), 1 = mancha com curvas de nível (melasma), 2 = lente.
interface Props {
  indice: number;
}
const { indice } = Astro.props;
const formas: string[][] = [
  ['M4 8c2.7-1.6 5.3-1.6 8 0s5.3 1.6 8 0', 'M4 12c2.7-1.6 5.3-1.6 8 0s5.3 1.6 8 0', 'M6 16c2-1.2 4-1.2 6 0s4 1.2 6 0'],
  ['M12 4.5c4.6 0 7.5 3 7.5 7s-3.4 8-7.8 8S4.5 16 4.5 12 7.4 4.5 12 4.5z', 'M12 8.5c2.4 0 3.8 1.5 3.8 3.4S14 15.8 11.8 15.8 8.3 14 8.3 12s1.3-3.5 3.7-3.5z', 'M12 11.2a0.8 0.8 0 1 0 0.01 0'],
  ['M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 1 0 0-13z', 'M15.3 15.3L20 20', 'M10.5 7.5v6M7.5 10.5h6'],
];
const desenho = formas[indice % formas.length];
---

<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {desenho.map((d, i) => <path d={d} pathLength="1" style={`--atraso:${i}`} />)}
</svg>
