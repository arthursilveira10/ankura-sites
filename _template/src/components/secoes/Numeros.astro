---
// NÚMEROS DO PROCEDIMENTO: duração, tempo para o efeito, retorno. Só com dados confirmados pelo médico.
// Um painel único, com ícone por número, e a observação de referência integrada embaixo do painel.
import Cabecalho from '../base/Cabecalho.astro';
import Icone from '../base/Icone.astro';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'numeros' }>;
}
const { dados: d } = Astro.props;
---

<section class="secao secao-abaixo nums">
  <div class="wrap">
    {d.titulo && <Cabecalho titulo={d.titulo} centro />}
    <div class="nums-painel">
      <ul class="nums-grade">
        {
          d.itens.map((it) => (
            <li class="num">
              {it.icone && (
                <span class="num-halo" aria-hidden="true">
                  <Icone nome={it.icone} tamanho={24} />
                </span>
              )}
              <span class="num-valor">{it.valor}</span>
              <span class="num-rotulo">{it.rotulo}</span>
            </li>
          ))
        }
      </ul>
      {
        d.observacao && (
          <p class="nums-obs">
            <Icone nome="selo" tamanho={18} />
            {d.observacao}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .nums .wrap > :global(.cab) {
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .nums-painel {
    border-radius: var(--radius-bloco);
    background: var(--color-superficie);
    box-shadow:
      inset 0 0 0 1px var(--color-linha),
      0 30px 60px -48px rgb(20 38 32 / 0.45);
    overflow: hidden;
  }
  .nums-grade {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .num {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 28px 16px;
    text-align: center;
  }
  .num:nth-child(even) {
    border-left: 1px solid var(--color-linha);
  }
  .num:nth-child(n + 3) {
    border-top: 1px solid var(--color-linha);
  }
  .num-halo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 4px;
    border-radius: 50%;
    color: var(--color-acao);
    background: radial-gradient(circle at 50% 42%, rgb(242 212 155 / 0.75), rgb(242 212 155 / 0) 70%);
  }
  .num-valor {
    font-family: var(--font-titulo);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-tinta);
  }
  .num-rotulo {
    max-width: 16em;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .nums-obs {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 16px 20px;
    font-size: 0.8125rem;
    color: var(--color-apagado);
    background: var(--color-superficie-2);
    text-align: center;
  }
  .nums-obs :global(svg) {
    flex: none;
    color: var(--color-acao);
  }
  @media (min-width: 1024px) {
    .nums-grade {
      grid-template-columns: repeat(var(--n, 4), 1fr);
    }
    .num {
      padding: 40px 24px;
    }
    .num:nth-child(n) {
      border-top: 0;
      border-left: 1px solid var(--color-linha);
    }
    .num:first-child {
      border-left: 0;
    }
  }
</style>
