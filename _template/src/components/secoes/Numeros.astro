---
// NÚMEROS DO PROCEDIMENTO: sessões, duração, retorno. Só com dados confirmados pelo médico.
import { titulo as fmt } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'numeros' }>;
}
const { dados: d } = Astro.props;
---

<section class="secao secao-abaixo nums">
  <div class="wrap">
    {d.titulo && <h2 class="t-h3 nums-titulo" data-revela set:html={fmt(d.titulo)} />}
    <dl class="nums-grade">
      {
        d.itens.map((it, i) => (
          <div class="num" data-revela style={`--atraso:${i}`}>
            <dt>{it.rotulo}</dt>
            <dd>{it.valor}</dd>
          </div>
        ))
      }
    </dl>
    {d.observacao && <p class="t-pequeno nums-obs medida">{d.observacao}</p>}
  </div>
</section>

<style>
  .nums {
    padding-block: calc(var(--secao) / 2);
  }
  .nums-titulo {
    margin-bottom: 24px;
  }
  .nums-grade {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-linha);
  }
  .num {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 20px 14px 4px 0;
  }
  .num:nth-child(even) {
    padding-left: 14px;
    border-left: 1px solid var(--color-linha);
  }
  .num dd {
    font-family: var(--font-titulo);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-tinta);
  }
  .num dt {
    font-size: var(--t-pequeno);
    color: var(--color-apagado);
  }
  .nums-obs {
    margin-top: 20px;
    color: var(--color-apagado);
  }
  @media (min-width: 768px) {
    .nums-grade {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
    }
    .num,
    .num:nth-child(even) {
      padding: 24px 24px 4px;
      border-left: 1px solid var(--color-linha);
    }
    .num:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
