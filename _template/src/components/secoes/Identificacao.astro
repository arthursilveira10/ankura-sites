---
// IDENTIFICAÇÃO: o paciente pensa "é exatamente isso que eu sinto".
// Grade de 2 colunas (1 no celular) com ícone de apoio em cada situação. Sem numeração (não há ordem)
// e sem cards iguais: linhas finas separam as situações.
import Cabecalho from '../base/Cabecalho.astro';
import CtaMeio from '../base/CtaMeio.astro';
import Icone from '../base/Icone.astro';
import { inline } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'identificacao' }>;
}
const { dados: d } = Astro.props;
---

<section class="secao secao-abaixo ident">
  <div class="wrap">
    <Cabecalho rotulo={d.rotulo} titulo={d.titulo} texto={d.texto} lado />
    <div class:list={['ident-grade', d.itens.length === 3 && 'ident-tres', d.itens.length > 3 && d.itens.length % 2 === 1 && 'ident-impar']}>
      {
        d.itens.map((it) => (
          <div class="ident-item">
            <span class="halo" aria-hidden="true">
              {it.icone && <Icone nome={it.icone} tamanho={30} />}
            </span>
            <div>
              <h3 class="ident-titulo">{it.titulo}</h3>
              <p set:html={inline(it.texto)} />
            </div>
          </div>
        ))
      }
    </div>
    <CtaMeio cta={d.cta} />
  </div>
</section>

<style>
  .ident-grade {
    display: grid;
    margin-top: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--color-linha);
  }
  .ident-item {
    display: grid;
    align-content: start;
    grid-template-columns: 52px 1fr;
    gap: 16px;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-linha);
  }
  .halo {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--color-acao);
    background: radial-gradient(circle at 50% 42%, rgb(242 212 155 / 0.75), rgb(242 212 155 / 0) 70%);
    transition: transform 0.6s var(--ease-ankura);
  }
  .ident-titulo {
    font-size: clamp(1.4375rem, 1.1rem + 1vw, 1.9375rem);
    line-height: 1.15;
  }
  .ident-item p {
    margin-top: 10px;
    max-width: 28em;
  }
  @media (hover: hover) {
    .ident-item:hover .halo {
      transform: scale(1.12);
    }
  }
  @media (min-width: 1024px) {
    .ident-grade {
      grid-template-columns: 1fr 1fr;
    }
    .ident-item {
      grid-template-columns: 64px 1fr;
      gap: 22px;
      padding: 40px 44px 44px 0;
    }
    .ident-item:nth-child(even) {
      padding: 40px 0 44px 44px;
      border-left: 1px solid var(--color-linha);
    }
    .halo {
      width: 64px;
      height: 64px;
    }
    .ident-tres {
      grid-template-columns: repeat(3, 1fr);
    }
    .ident-tres .ident-item,
    .ident-tres .ident-item:nth-child(even) {
      grid-template-columns: 1fr;
      align-content: start;
      padding: 40px 32px 44px;
      border-left: 1px solid var(--color-linha);
    }
    .ident-tres .ident-item:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .ident-tres .ident-item:last-child {
      padding-right: 0;
    }
    .ident-impar .ident-item:last-child {
      grid-column: 1 / -1;
      justify-self: center;
      max-width: 50%;
      padding: 40px 0 44px;
      border-left: 0;
    }
  }
</style>
