---
// IDENTIFICAÇÃO: "é exatamente isso que eu sinto".
// lista: situações em linhas/cards. cartas: cartas que se empilham ao rolar (ótimo no celular).
import Cabecalho from '../base/Cabecalho.astro';
import CtaMeio from '../base/CtaMeio.astro';
import { inline } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'identificacao' }>;
}
const { dados: d } = Astro.props;
---

<section class="secao secao-abaixo ident">
  <div class:list={['wrap', 'ident-grade', d.variante === 'cartas' && 'ident-cartas']}>
    <div class="ident-cab">
      <Cabecalho rotulo={d.rotulo} titulo={d.titulo} texto={d.texto} />
    </div>
    <ol class="ident-lista">
      {
        d.itens.map((it, i) => (
          <li class="ident-item" data-revela={d.variante === 'cartas' ? undefined : ''} style={`--i:${i};--atraso:${i}`}>
            <span class="ident-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="t-h3">{it.titulo}</h3>
            <p set:html={inline(it.texto)} />
          </li>
        ))
      }
    </ol>
  </div>
  <div class="wrap"><CtaMeio cta={d.cta} /></div>
</section>

<style>
  .ident-grade {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .ident-lista {
    display: grid;
    gap: 12px;
  }
  .ident-item {
    display: grid;
    gap: 8px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-card);
    background: var(--color-superficie);
    box-shadow: inset 0 0 0 1px var(--color-linha);
  }
  .ident-num {
    font-size: var(--t-rotulo);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-destaque);
  }
  /* Cartas empilhadas */
  .ident-cartas .ident-item {
    position: sticky;
    top: calc(var(--header) + 12px + var(--i) * 14px);
    min-height: 200px;
    align-content: start;
    box-shadow:
      inset 0 0 0 1px var(--color-linha),
      0 -18px 40px -26px rgb(0 0 0 / 0.3);
  }
  .ident-cartas .ident-item:nth-child(even) {
    background: var(--color-superficie-2);
  }
  @media (min-width: 1024px) {
    .ident-grade {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
    .ident-cab {
      position: sticky;
      top: calc(var(--header) + 48px);
    }
    .ident-cartas .ident-item {
      top: calc(var(--header) + 48px + var(--i) * 18px);
      min-height: 240px;
    }
  }
</style>
