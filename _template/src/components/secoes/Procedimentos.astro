---
// PROCEDIMENTOS (home): portas de entrada para as páginas de procedimento.
// lista-com-imagem (padrão, no espírito do Bonança): ícone, miniatura, nome (um peso só), descrição e botão
//   redondo; o item aberto faz a foto crescer e mostra o detalhe e o link. Desktop abre no hover; celular no toque.
// lista-em-linhas: linhas simples com seta. cards: 2 a 4 cards com foto.
import Cabecalho from '../base/Cabecalho.astro';
import Foto from '../base/Foto.astro';
import Icone from '../base/Icone.astro';
import IconeProcedimento from '../conceito/IconeProcedimento.astro';
import { procedimentos } from '../../lib/dados';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'procedimentos' }>;
}
const { dados: d } = Astro.props;
const lp = Astro.locals.ctx?.modoLP;
const itens =
  d.itens ??
  (await procedimentos()).map((p) => ({
    nome: p.data.nome,
    descricao: p.data.resumo ?? '',
    detalhe: p.data.detalhe,
    icone: p.data.icone,
    link: lp ? `/lp/${p.id}` : `/${p.id}`,
    foto: p.data.foto,
  }));
---

<section class="secao secao-abaixo procs" id="procedimentos">
  <div class="wrap">
    <Cabecalho rotulo={d.rotulo} titulo={d.titulo} texto={d.texto} lado />

    {
      d.variante === 'lista-com-imagem' ? (
        <div class="pi-lista" data-abre-no-hover>
          {itens.map((it, i) => (
            <details name="procedimentos" open={i === 0}>
              <summary>
                <span class="pi-ico">
                  <IconeProcedimento nome={it.icone} indice={i} />
                </span>
                <span class="pi-mini">
                  <Foto foto={it.foto} sizes="(min-width: 1024px) 340px, 90vw" larguras={[340, 680]} />
                </span>
                <span class="pi-txt">
                  <span class="pi-nome">{it.nome}</span>
                  <span class="pi-resumo">{it.descricao}</span>
                  <span class="pi-extra">
                    <span>
                      {it.detalhe && <span class="pi-detalhe">{it.detalhe}</span>}
                      {it.link && (
                        <a href={it.link} class="pi-ver">
                          Ver como funciona <Icone nome="seta" tamanho={16} />
                        </a>
                      )}
                    </span>
                  </span>
                </span>
                <span class="pi-mais" aria-hidden="true">
                  <Icone nome="mais" tamanho={20} />
                </span>
              </summary>
            </details>
          ))}
        </div>
      ) : d.variante === 'cards' ? (
        <ul class="procs-cards">
          {itens.map((it) => (
            <li>
              <a href={it.link} class="card">
                <div class="card-foto">
                  <Foto foto={it.foto} sizes="(min-width: 1024px) 380px, 90vw" proporcao="4/3" />
                </div>
                <div class="card-corpo">
                  <h3 class="t-h3">{it.nome}</h3>
                  <p class="t-pequeno">{it.descricao}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="procs-linhas">
          {itens.map((it, i) => (
            <li>
              <a href={it.link} class="pl">
                <span class="pi-ico">
                  <IconeProcedimento nome={it.icone} indice={i} />
                </span>
                <span class="pl-texto">
                  <span class="pi-nome">{it.nome}</span>
                  <span class="pi-resumo">{it.descricao}</span>
                </span>
                <span class="pi-mais" aria-hidden="true">
                  <Icone nome="seta" tamanho={18} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .procs .wrap > :global(.cab) {
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  /* ---------- lista com imagem ---------- */
  .pi-lista {
    border-top: 1px solid var(--color-linha);
  }
  .pi-lista details {
    border-bottom: 1px solid var(--color-linha);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 46px;
    gap: 14px;
    align-items: start;
    padding: 22px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .pi-ico,
  .pi-mini {
    display: none;
  }
  .pi-ico {
    color: var(--color-acao);
    justify-self: center;
    margin-top: 12px;
  }
  .pi-mini {
    position: relative;
    width: 168px;
    height: 104px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-superficie-2);
    transition:
      width 0.7s var(--ease-ankura),
      height 0.7s var(--ease-ankura);
  }
  .pi-mini :global(.foto-reservada) {
    font-size: 0;
  }
  .pi-txt {
    display: grid;
  }
  .pi-nome {
    font-family: var(--font-titulo);
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-muda);
    transition: color 0.4s;
  }
  .pi-resumo {
    margin-top: 6px;
    color: var(--color-apagado);
  }
  .pi-extra {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.7s var(--ease-ankura),
      opacity 0.5s;
  }
  .pi-extra > span {
    overflow: hidden;
  }
  details[open] .pi-extra {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .pi-detalhe {
    display: block;
    margin-top: 16px;
    max-width: 34em;
  }
  .pi-ver {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 16px;
    padding-bottom: 2px;
    color: var(--color-acao);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--color-acao) 30%, transparent);
  }
  .pi-ver:hover {
    border-color: var(--color-acao);
  }
  .pi-mais {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-top: 6px;
    border-radius: 50%;
    color: var(--color-tinta);
    box-shadow: inset 0 0 0 1px var(--color-linha);
    transition: all 0.4s var(--ease-ankura);
  }
  .pi-mais :global(svg) {
    transition: transform 0.4s var(--ease-ankura);
  }
  summary:hover .pi-nome,
  details[open] .pi-nome {
    color: var(--color-tinta);
  }
  summary:hover .pi-mais {
    box-shadow: inset 0 0 0 1px var(--color-tinta);
  }
  details[open] .pi-mais {
    background: var(--color-luz);
    box-shadow: none;
  }
  details[open] .pi-mais :global(svg) {
    transform: rotate(45deg);
  }
  @media (min-width: 1024px) {
    summary {
      grid-template-columns: 56px auto 1fr 48px;
      gap: 32px;
      padding: 26px 0;
    }
    .pi-ico,
    .pi-mini {
      display: block;
    }
    details[open] .pi-mini {
      width: 340px;
      height: 232px;
    }
    .pi-txt {
      padding-top: 8px;
    }
  }

  /* ---------- lista em linhas ---------- */
  .procs-linhas {
    border-top: 1px solid var(--color-linha);
  }
  .pl {
    display: grid;
    grid-template-columns: 1fr 46px;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-linha);
    color: inherit;
    text-decoration: none;
  }
  .pl-texto {
    display: grid;
  }
  .pl:hover .pi-nome {
    color: var(--color-tinta);
  }
  .pl:hover .pi-mais {
    background: var(--color-acao);
    color: #fff;
    box-shadow: none;
  }
  @media (min-width: 1024px) {
    .pl {
      grid-template-columns: 56px 1fr 48px;
      gap: 32px;
    }
    .pl .pi-ico {
      display: block;
      margin-top: 0;
    }
  }

  /* ---------- cards ---------- */
  .procs-cards {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-superficie);
    box-shadow: inset 0 0 0 1px var(--color-linha);
    color: inherit;
    text-decoration: none;
    transition: transform 0.5s var(--ease-ankura);
  }
  .card:hover {
    transform: translateY(-4px);
  }
  .card-corpo {
    display: grid;
    gap: 6px;
    padding: 20px 22px 24px;
  }
  @media (prefers-reduced-motion: reduce) {
    .pi-mini,
    .pi-extra,
    .pi-nome,
    .pi-mais {
      transition: none;
    }
  }
</style>
