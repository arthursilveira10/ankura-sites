---
// PROVA SOCIAL: depoimentos reais (mínima edição), numa faixa que passa devagar na horizontal.
// Desktop: rola sozinha, para quando o mouse entra e pode ser arrastada. Celular: deslize com o dedo.
// As bordas laterais somem num degradê. Sem JS ou com movimento reduzido: rolagem manual.
import Cabecalho from '../base/Cabecalho.astro';
import CtaMeio from '../base/CtaMeio.astro';
import Icone from '../base/Icone.astro';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'depoimentos' }>;
}
const { dados: d } = Astro.props;
// Repete os depoimentos até encher a faixa (no mínimo 6 cards) e duplica para o laço contínuo.
const base = Array.from({ length: Math.max(1, Math.ceil(6 / d.itens.length)) }, () => d.itens).flat();
const iniciais = (nome: string) =>
  nome
    .replace(/\[.*?\]/g, '')
    .split(/[\s.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0])
    .join('');
---

<section class="secao secao-abaixo dep" id="depoimentos">
  <div class="wrap dep-topo">
    <Cabecalho rotulo={d.rotulo} titulo={d.titulo} centro />
    {
      d.nota && (
        <a class="dep-nota" href={d.nota.link ?? '#depoimentos'} {...(d.nota.link ? { target: '_blank', rel: 'noopener' } : {})}>
          <span class="dep-valor">{d.nota.valor}</span>
          <span class="dep-estrelas" aria-hidden="true">
            {[1, 2, 3, 4, 5].map(() => <Icone nome="estrela" tamanho={16} />)}
          </span>
          <span class="dep-total">{d.nota.total}</span>
        </a>
      )
    }
  </div>
  <div class="dep-trilho" data-carrossel tabindex="0" aria-label="Depoimentos de pacientes (deslize para ver mais)">
    <ul class="dep-lista">
      {
        [...base, ...base].map((it, i) => (
          <li class="dep-card" aria-hidden={i >= base.length || i >= d.itens.length ? 'true' : undefined}>
            <span class="dep-aspas" aria-hidden="true">
              “
            </span>
            <blockquote>
              <p>{it.texto}</p>
            </blockquote>
            <p class="dep-autor">
              <span class="dep-avatar" aria-hidden="true">
                {iniciais(it.autor)}
              </span>
              <span>
                <strong>{it.autor}</strong>
                {it.origem && <span class="dep-origem">avaliação no {it.origem}</span>}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap dep-cta"><CtaMeio cta={d.cta} centro /></div>
</section>

<style>
  .dep-topo {
    display: grid;
    gap: 20px;
    justify-items: center;
    margin-bottom: clamp(32px, 5vw, 56px);
    text-align: center;
  }
  .dep-nota {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    border-radius: var(--radius-pilula);
    background: var(--color-superficie);
    box-shadow: inset 0 0 0 1px var(--color-linha);
    color: var(--color-tinta);
    text-decoration: none;
  }
  .dep-valor {
    font-family: var(--font-titulo);
    font-size: 1.5rem;
    line-height: 1;
  }
  .dep-estrelas {
    display: flex;
    gap: 2px;
    color: #c9963a;
  }
  .dep-total {
    font-size: 0.8125rem;
    color: var(--color-apagado);
  }
  .dep-trilho {
    overflow-x: auto;
    scrollbar-width: none;
    cursor: grab;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .dep-trilho::-webkit-scrollbar {
    display: none;
  }
  .dep-trilho:global(.arrastando) {
    cursor: grabbing;
  }
  .dep-lista {
    display: flex;
    gap: 16px;
    width: max-content;
    margin: 0;
    padding: 8px var(--margem) 24px;
    list-style: none;
  }
  .dep-card {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 24px;
    width: min(84vw, 380px);
    padding: 32px 28px 28px;
    border-radius: var(--radius-card);
    background: var(--color-superficie);
    box-shadow:
      inset 0 0 0 1px var(--color-linha),
      0 24px 40px -36px rgb(20 38 32 / 0.45);
    user-select: none;
  }
  .dep-aspas {
    position: absolute;
    top: 6px;
    right: 22px;
    font-family: var(--font-titulo);
    font-size: 5.5rem;
    line-height: 1;
    color: var(--color-luz);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    position: relative;
    font-family: var(--font-titulo);
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--color-tinta);
  }
  .dep-autor {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
  }
  .dep-autor strong {
    display: block;
    font-weight: 500;
    color: var(--color-tinta);
  }
  .dep-origem {
    color: var(--color-apagado);
  }
  .dep-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-acao);
    background: radial-gradient(circle at 50% 40%, rgb(242 212 155 / 0.9), rgb(242 212 155 / 0.35) 70%);
  }
  .dep-cta :global(.cta-meio) {
    margin-top: 24px;
  }
</style>
