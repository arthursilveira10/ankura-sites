---
// COMO FUNCIONA (a experiência).
// passos-com-linha (padrão): bloco escuro arredondado, título fixo à esquerda e passos à direita;
//   o sol do conceito desce pela linha com a rolagem (do primeiro ao último passo) e acende cada etapa.
// passos-simples: grade sem efeito, para páginas de intenção urgente.
// cartas-empilhadas: cartas sticky (pesa visualmente; use só com motivo).
import Cabecalho from '../base/Cabecalho.astro';
import Botao from '../base/Botao.astro';
import CtaMeio from '../base/CtaMeio.astro';
import Icone from '../base/Icone.astro';
import { inline, titulo as fmtTitulo, paragrafos } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'como-funciona' }>;
}
const { dados: d } = Astro.props;
const v = d.variante;
const pilares = d.passos.every((p) => p.icone); // sem ordem: ícone no lugar do número
---

{
  v === 'passos-com-linha' ? (
    <section class="secao-abaixo cf-casca" id="como-funciona">
      <div class="wrap">
        <div class="cf-bloco escuro">
          <div class="cf-grade">
            <div class="cf-fixo">
              <h2 class="t-h2 medida-titulo" set:html={fmtTitulo(d.titulo)} />
              {paragrafos(d.texto).map((p) => <p class="cf-apoio" set:html={p} />)}
            </div>
            <div>
              <ol class="cf-passos" data-sol>
                <span class="trilho decor" aria-hidden="true" />
                <span class="aceso decor" aria-hidden="true" />
                <span class="sol decor" aria-hidden="true" />
                {d.passos.map((p) => (
                  <li data-passo>
                    {p.quando && <p class="cf-quando">{p.quando}</p>}
                    <h3 class="cf-titulo">{p.titulo}</h3>
                    <p set:html={inline(p.texto)} />
                  </li>
                ))}
              </ol>
              {d.cta && (
                <div class="cf-cta">
                  <Botao texto={d.cta.texto} posicao={d.cta.posicao} estilo="claro" />
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class:list={['secao secao-abaixo cf', `cf-${v}`]}>
      <div class="wrap">
        <Cabecalho rotulo={d.rotulo} titulo={d.titulo} texto={d.texto} />
        <ol class="cf-lista">
          {d.passos.map((p, i) => (
            <li class="cf-item" style={`--i:${i}`}>
              <span class="cf-num" aria-hidden="true">
                {pilares && p.icone ? <Icone nome={p.icone} tamanho={22} /> : i + 1}
              </span>
              <div>
                {p.quando && <p class="cf-quando">{p.quando}</p>}
                <h3 class="t-h3">{p.titulo}</h3>
                <p set:html={inline(p.texto)} />
              </div>
            </li>
          ))}
        </ol>
        <CtaMeio cta={d.cta} />
      </div>
    </section>
  )
}

<style>
  /* ---------- passos com linha: o sol percorre ---------- */
  .cf-casca {
    padding-block: clamp(24px, 4vw, 48px);
  }
  .cf-bloco {
    position: relative;
    overflow: clip;
    margin-inline: calc(-1 * var(--margem) + 12px);
    padding: clamp(64px, 8vw, 120px) clamp(22px, 5.5vw, 88px);
    border-radius: var(--radius-bloco);
  }
  .cf-bloco::before {
    content: '';
    position: absolute;
    width: 1100px;
    height: 1100px;
    left: -420px;
    top: -640px;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle, rgb(242 212 155 / 0.13), rgb(242 212 155 / 0) 62%);
  }
  .cf-grade {
    position: relative;
    display: grid;
    gap: 40px;
  }
  .cf-fixo {
    text-align: center;
  }
  .cf-fixo h2 {
    color: #fff;
    margin-inline: auto;
  }
  .cf-apoio {
    margin: 20px auto 0;
    max-width: 22em;
  }
  .cf-passos {
    position: relative;
    margin: 0;
    padding: 0 0 0 44px;
    list-style: none;
  }
  .trilho,
  .aceso {
    position: absolute;
    left: 11.5px;
    width: 1px;
    background: var(--color-escuro-linha);
  }
  .aceso {
    left: 11px;
    width: 2px;
    background: linear-gradient(to bottom, rgb(242 212 155 / 0.2), var(--color-luz));
    transform-origin: top;
    transform: scaleY(0);
  }
  .sol {
    position: absolute;
    left: 12px;
    top: 0;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: var(--color-luz-forte);
    will-change: transform;
    box-shadow:
      0 0 0 6px rgb(242 212 155 / 0.22),
      0 0 0 14px rgb(242 212 155 / 0.08),
      0 0 56px 16px rgb(242 212 155 / 0.4);
  }
  .cf-passos li {
    position: relative;
    padding-bottom: 56px;
  }
  .cf-passos li:last-child {
    padding-bottom: 0;
  }
  .cf-passos li::before {
    content: '';
    position: absolute;
    left: -36.5px;
    top: 11px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-escuro);
    box-shadow: inset 0 0 0 1.5px rgb(237 241 236 / 0.42);
    transition: all 0.5s var(--ease-ankura);
  }
  .cf-passos li:global(.feito)::before {
    background: var(--color-luz);
    box-shadow: 0 0 14px 3px rgb(242 212 155 / 0.45);
  }
  .cf-quando {
    font-size: 0.8125rem;
    line-height: 1.2;
  }
  .cf-titulo {
    margin-top: 4px;
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 1.9375rem);
    line-height: 1.2;
    color: var(--color-escuro-texto);
    opacity: 0.6;
    transition:
      opacity 0.5s,
      color 0.5s;
  }
  .cf-passos li:global(.feito) .cf-titulo {
    opacity: 1;
    color: #fff;
  }
  .cf-passos li p:last-child {
    margin-top: 8px;
    max-width: 32em;
  }
  .cf-cta {
    margin-top: 48px;
  }
  @media (min-width: 1024px) {
    .cf-bloco {
      margin-inline: 0;
    }
    .cf-grade {
      grid-template-columns: 0.82fr 1.18fr;
      gap: clamp(32px, 6vw, 96px);
    }
    .cf-fixo {
      position: sticky;
      top: 132px;
      align-self: start;
      text-align: left;
    }
    .cf-fixo h2,
    .cf-apoio {
      margin-inline: 0;
    }
    .cf-passos {
      padding-left: 64px;
    }
    .trilho {
      left: 19.5px;
    }
    .aceso {
      left: 19px;
    }
    .sol {
      left: 20px;
    }
    .cf-passos li {
      padding-bottom: 60px;
    }
    .cf-passos li::before {
      left: -48.5px;
    }
    .cf-cta {
      margin-left: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cf-passos li::before,
    .cf-titulo {
      transition: none;
    }
  }

  /* ---------- passos simples e cartas ---------- */
  .cf-lista {
    display: grid;
    gap: 16px;
    margin: clamp(36px, 5vw, 56px) 0 0;
    padding: 0;
    list-style: none;
  }
  .cf-item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--color-superficie);
    box-shadow: inset 0 0 0 1px var(--color-linha);
  }
  .cf-num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-weight: 600;
    color: var(--color-tinta);
    background: radial-gradient(circle at 50% 42%, rgb(242 212 155 / 0.9), rgb(242 212 155 / 0.25) 70%);
  }
  .cf-item h3 + p {
    margin-top: 6px;
  }
  .cf-item .cf-quando {
    color: var(--color-apagado);
  }
  @media (min-width: 1024px) {
    .cf-passos-simples .cf-lista {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .cf-cartas-empilhadas .cf-item {
      position: sticky;
      top: calc(110px + var(--i) * 14px);
      padding: 32px 40px;
      box-shadow:
        inset 0 0 0 1px var(--color-linha),
        0 24px 40px -30px rgb(20 38 32 / 0.4);
    }
  }
</style>
