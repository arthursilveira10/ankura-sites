---
// O PROFISSIONAL: quem é o médico, por que faz o que faz e como trabalha.
// foto-e-texto (padrão): foto à esquerda (ou composição pronta, ver `composicao`) + texto + até 3 fatos com ícone.
// com-linha-do-tempo: o mesmo, seguido dos marcos da trajetória.
// Costuma entrar numa faixa de fundo (faixa: true), junto com o CTA final.
import { Picture } from 'astro:assets';
import Foto from '../base/Foto.astro';
import Icone from '../base/Icone.astro';
import { titulo as fmtTitulo, paragrafos } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'profissional' }>;
}
const { dados: d } = Astro.props;
---

<section class="secao secao-abaixo prof" id="sobre">
  <div class="wrap prof-grade">
    <div class="prof-foto">
      {
        d.composicao && d.foto.src ? (
          <Picture
            src={d.foto.src}
            alt={d.foto.alt}
            widths={[400, 700, 1000].filter((w) => w <= d.foto.src!.width)}
            sizes="(min-width: 1024px) 540px, 360px"
            formats={['avif', 'webp']}
                fallbackFormat="webp"
            loading="lazy"
            class="prof-composicao"
            pictureAttributes={{ class: 'contents' }}
          />
        ) : (
          <div class="prof-moldura">
            <Foto foto={d.foto} sizes="(min-width: 1024px) 480px, 90vw" proporcao="4/5" />
          </div>
        )
      }
    </div>
    <div class="prof-texto">
      {d.rotulo && <p class="rotulo">{d.rotulo}</p>}
      <h2 class="t-h2" set:html={fmtTitulo(d.titulo)} />
      <div class="prof-corpo">
        {paragrafos(d.texto).map((p) => <p set:html={p} />)}
      </div>
      {
        d.fatos.length > 0 && (
          <ul class="fatos">
            {d.fatos.map((f) => (
              <li>
                {f.icone && <Icone nome={f.icone} tamanho={22} class="fato-ico" />}
                <span class="fato-valor">{f.valor}</span>
                <span class="fato-rotulo">{f.rotulo}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  {
    d.variante === 'com-linha-do-tempo' && d.marcos.length > 0 && (
      <div class="wrap">
        <ol class="marcos">
          {d.marcos.map((m) => (
            <li>
              <span class="marco-quando">{m.quando}</span>
              <span class="marco-titulo">{m.titulo}</span>
              {m.onde && <span class="marco-onde">{m.onde}</span>}
            </li>
          ))}
        </ol>
      </div>
    )
  }
</section>

<style>
  .prof-grade {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .prof-foto :global(.prof-composicao) {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(0 34px 44px rgb(20 38 32 / 0.18));
  }
  .prof-moldura {
    max-width: 420px;
    margin-inline: auto;
    border-radius: var(--radius-bloco);
    overflow: hidden;
  }
  .prof-texto h2 {
    text-align: center;
  }
  .prof-corpo {
    display: grid;
    gap: 18px;
    margin-top: 28px;
    max-width: 36em;
  }
  .fatos {
    display: grid;
    gap: 24px;
    margin: 40px 0 0;
    padding: 28px 0 0;
    list-style: none;
    border-top: 1px solid rgb(20 38 32 / 0.16);
  }
  .fatos li {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .fatos :global(.fato-ico) {
    color: var(--color-acao);
  }
  .fatos .fato-valor {
    font-family: var(--font-titulo);
    font-size: 1.6875rem;
    line-height: 1.1;
    color: var(--color-tinta);
  }
  .fatos .fato-rotulo {
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .marcos {
    display: grid;
    gap: 22px;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 28px 0 0;
    list-style: none;
    border-top: 1px solid rgb(20 38 32 / 0.16);
  }
  .marcos li {
    position: relative;
    display: grid;
    gap: 2px;
    padding-left: 26px;
  }
  .marcos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-luz);
    box-shadow: 0 0 12px 2px rgb(242 212 155 / 0.6);
  }
  .marco-quando {
    font-size: 0.8125rem;
    color: var(--color-apagado);
  }
  .marco-titulo {
    font-family: var(--font-titulo);
    font-size: 1.25rem;
    color: var(--color-tinta);
  }
  .marco-onde {
    font-size: 0.875rem;
  }
  @media (min-width: 1024px) {
    .prof-grade {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(32px, 6vw, 96px);
    }
    .prof-foto :global(.prof-composicao) {
      max-width: 540px;
    }
    .prof-texto h2 {
      text-align: left;
    }
    .fatos {
      grid-template-columns: repeat(3, 1fr);
    }
    .marcos {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
</style>
