---
// O PROFISSIONAL: foto com o recorte da identidade + texto + fatos. Variante com linha do tempo.
import Cabecalho from '../base/Cabecalho.astro';
import Foto from '../base/Foto.astro';
import Marcador from '../conceito/Marcador.astro';
import { paragrafos } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'profissional' }>;
}
const { dados: d } = Astro.props;
const linha = d.variante === 'com-linha-do-tempo' && d.marcos.length > 0;
---

<section class="secao secao-abaixo prof" id="sobre">
  <div class="wrap prof-grade">
    <div class="prof-foto" data-revela-foto>
      <Foto foto={d.foto} sizes="(min-width: 1024px) 480px, 90vw" proporcao="4/5" />
    </div>
    <div class="prof-texto">
      <Cabecalho rotulo={d.rotulo} titulo={d.titulo} />
      <div class="texto medida" data-revela style="--atraso:2">
        {paragrafos(d.texto).map((p) => <p set:html={p} />)}
      </div>
      {
        d.fatos.length > 0 && (
          <dl class="prof-fatos">
            {d.fatos.map((f, i) => (
              <div data-revela style={`--atraso:${i + 2}`}>
                <dt class="t-pequeno">{f.rotulo}</dt>
                <dd>{f.valor}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>

  {
    linha && (
      <div class="wrap">
        <ol class="linha" data-progresso style={`--n:${d.marcos.length}`}>
          <span class="linha-trilho decor" aria-hidden="true">
            <span class="linha-traco" />
          </span>
          {d.marcos.map((mc, i) => (
            <li class="marco" style={`--i:${i}`}>
              <span class="marco-ponto decor" aria-hidden="true">
                <Marcador />
              </span>
              <span class="marco-quando">{mc.quando}</span>
              <strong class="marco-titulo">{mc.titulo}</strong>
              {mc.onde && <span class="marco-onde t-pequeno">{mc.onde}</span>}
            </li>
          ))}
        </ol>
      </div>
    )
  }
</section>

<style>
  .prof-grade {
    display: grid;
    gap: clamp(32px, 5vw, 80px);
  }
  .prof-foto {
    border-radius: var(--recorte-foto);
    overflow: hidden;
    max-width: 480px;
    background: var(--color-superficie-2);
  }
  .prof-texto {
    display: grid;
    gap: 22px;
    align-content: center;
  }
  .prof-fatos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0;
    margin-top: 8px;
    border-top: 1px solid var(--color-linha);
  }
  .prof-fatos > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 18px 14px 0 0;
  }
  .prof-fatos dd {
    font-family: var(--font-titulo);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    line-height: 1;
    color: var(--color-tinta);
    letter-spacing: -0.03em;
  }
  .prof-fatos dt {
    color: var(--color-apagado);
  }

  /* Linha do tempo: o traço se preenche com a rolagem e acende os marcos */
  .linha {
    --k: clamp(0, calc(var(--p) * 1.25), 1);
    position: relative;
    display: grid;
    gap: 28px;
    margin-top: clamp(56px, 7vw, 96px);
    padding-left: 36px;
  }
  .linha-trilho {
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--color-linha);
  }
  .linha-traco {
    position: absolute;
    inset: 0;
    background: var(--color-destaque);
    transform-origin: top;
    transform: scaleY(var(--k));
  }
  .marco {
    --on: clamp(0, calc((var(--k) * var(--n) - var(--i)) * 2), 1);
    position: relative;
    display: grid;
    gap: 2px;
    opacity: calc(0.45 + var(--on) * 0.55);
  }
  .marco-ponto {
    position: absolute;
    left: -36px;
    top: 2px;
    width: 17px;
    height: 17px;
    display: grid;
    place-items: center;
    color: var(--color-destaque);
    background: var(--color-fundo);
    transform: scale(calc(0.7 + var(--on) * 0.3));
  }
  .marco-quando {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-destaque);
  }
  .marco-titulo {
    font-weight: 500;
    color: var(--color-tinta);
    line-height: 1.3;
  }
  .marco-onde {
    color: var(--color-apagado);
  }

  @media (min-width: 1024px) {
    .prof-grade {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
    .linha {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      padding-left: 0;
      padding-top: 36px;
      gap: 24px;
    }
    .linha-trilho {
      left: 0;
      right: 0;
      top: 8px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .linha-traco {
      transform-origin: left;
      transform: scaleX(var(--k));
    }
    .marco-ponto {
      left: 0;
      top: -36px;
    }
  }
</style>
