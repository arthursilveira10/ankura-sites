---
// POR QUE CONSULTA PARTICULAR (opcional): tom de esclarecimento, nunca crítica a convênios.
import Cabecalho from '../base/Cabecalho.astro';
import { inline } from '../../lib/texto';
import type { Secao } from '../../lib/dados';
interface Props {
  dados: Extract<Secao, { tipo: 'particular' }>;
}
const { dados: d } = Astro.props;
---

<section class="secao secao-abaixo part">
  <div class="wrap">
    <Cabecalho rotulo={d.rotulo} titulo={d.titulo} />
    <ul class="part-grade">
      {
        d.itens.map((it, i) => (
          <li data-revela style={`--atraso:${i}`}>
            <h3 class="t-h3">{it.titulo}</h3>
            <p set:html={inline(it.texto)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .part-grade {
    display: grid;
    gap: 0;
    margin-top: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--color-linha);
  }
  .part-grade li {
    display: grid;
    gap: 6px;
    padding-block: 22px;
    border-bottom: 1px solid var(--color-linha);
  }
  @media (min-width: 768px) {
    .part-grade {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0 32px;
    }
  }
</style>
